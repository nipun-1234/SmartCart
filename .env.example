# Local PostgreSQL connection. Create this database before running migrations.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/smartcart_dev
# Set true only when your managed PostgreSQL provider requires TLS.
DATABASE_SSL=false
PORT=3000
NODE_ENV=development

# Payment provider values are intentionally not configured until merchant setup
# and the checkout integration are implemented. Never commit live credentials.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
